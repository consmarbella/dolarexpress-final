{
  "name": "dolarexpress",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node copy-html-files.js",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "seo:sitemap": "node generate-sitemap.js",
    "seo:interlinking": "python add_interlinking.py",
    "seo:all": "node generate-sitemap.js && python add_interlinking.py",
    "deploy": "npm run seo:all && npm run build"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "glob": "^13.0.6",
    "http-node": "^1.2.0",
    "isomorphic-git": "^1.37.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
