{
  "buildCommand": "vite build && node copy-html-files.js",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "index, follow" }
      ]
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/([^/]+)\\.html$",
      "dest": "/$1/index.html"
    },
    {
      "src": "/([^/]+)/([^/]+)/?$",
      "dest": "/$1/$2/index.html"
    },
    {
      "src": "/([^/]+)/?$",
      "dest": "/$1/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "redirects": [
